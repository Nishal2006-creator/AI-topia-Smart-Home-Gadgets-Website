rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pnishalsam@gmail.com' ||
        request.auth.token.email == 'nishalsamprasath5@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return (!data.keys().hasAny(['id']) || data.id == productId) &&
               (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100)) &&
               (!data.keys().hasAny(['price']) || (data.price is number && data.price >= 0)) &&
               (!data.keys().hasAny(['category']) || data.category is string) &&
               (!data.keys().hasAny(['image']) || (data.image is string && data.image.size() <= 1048576)) &&
               (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 50000)) &&
               (!data.keys().hasAny(['room']) || data.room is string) &&
               (!data.keys().hasAny(['rating']) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
               (!data.keys().hasAny(['isNew']) || data.isNew is bool) &&
               (!data.keys().hasAny(['features']) || data.features is list);
      }

      allow read: if true;
      allow create: if isAdmin() && 
                    incoming().keys().hasAll(['id', 'name', 'price', 'category', 'image', 'description', 'room']) &&
                    isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.total is number && data.total >= 0 &&
               data.status in ['pending', 'processing', 'shipped', 'delivered'] &&
               data.createdAt == request.time;
      }

      allow create: if isSignedIn() && isValidOrder(incoming()) && isValidId(orderId);
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status in ['pending', 'processing', 'shipped', 'delivered'];
      allow delete: if false;
    }

    // Users
    match /users/{userId} {
      function isValidUser(data) {
        // Core fields must always be valid if present
        return (!data.keys().hasAny(['uid']) || data.uid == userId) &&
               (!data.keys().hasAny(['email']) || data.email is string) &&
               (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool) &&
               (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100)) &&
               (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
               (!data.keys().hasAny(['linkedServices']) || data.linkedServices is map);
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                    isValidUser(incoming()) && 
                    (!incoming().keys().hasAny(['isAdmin']) || incoming().isAdmin == existing().isAdmin); // Prevent self-elevation
    }

    // Global Config
    match /config/theme {
      function isValidTheme(data) {
        return data.keys().hasAll(['primaryColor', 'secondaryColor', 'accentColor', 'uiStyle', 'fontSize', 'animationsEnabled', 'glowEnabled', 'borderRadius', 'containerPadding', 'glassIntensity', 'fontFamily', 'backgroundStyle']) &&
               data.primaryColor is string && data.primaryColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.secondaryColor is string && data.secondaryColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.accentColor is string && data.accentColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.uiStyle in ['glassmorphism', 'neon', 'minimal', '3d'] &&
               data.fontSize is number && data.fontSize >= 12 && data.fontSize <= 24 &&
               data.animationsEnabled is bool &&
               data.glowEnabled is bool &&
               data.borderRadius is number && data.borderRadius >= 0 &&
               data.containerPadding is number && data.containerPadding >= 0 &&
               data.glassIntensity is number && data.glassIntensity >= 0 &&
               data.fontFamily is string &&
               data.backgroundStyle in ['stars', 'neural', 'dust', 'void', 'nebula'];
      }

      allow read: if true;
      allow write: if isAdmin() && isValidTheme(incoming());
    }

    match /config/bot {
      function isValidBotConfig(data) {
        return data.keys().hasAll(['primaryColor', 'secondaryColor', 'eyeColor', 'pattern']) &&
               data.primaryColor is string && data.primaryColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.secondaryColor is string && data.secondaryColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.eyeColor is string && data.eyeColor.matches('^#[A-Fa-f0-9]{6}$') &&
               data.pattern in ['none', 'dots', 'grid', 'hex'];
      }

      allow read: if true;
      allow write: if isAdmin() && isValidBotConfig(incoming());
    }

    // Admins helper collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }

    // Automations
    match /automations/{automationId} {
      function isValidAutomation(data) {
        return data.keys().hasAll(['userId', 'name', 'trigger', 'actions', 'enabled', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.name is string && data.name.size() <= 100 &&
               data.actions is list && data.actions.size() >= 0 &&
               data.enabled is bool &&
               data.createdAt == request.time;
      }

      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isValidAutomation(incoming()) && isValidId(automationId);
      allow update: if isOwner(existing().userId) && isValidAutomation(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // Notifications
    match /notifications/{notificationId} {
      function isValidNotification(data) {
        return data.keys().hasAll(['type', 'target', 'message', 'status', 'createdAt']) &&
               data.type in ['email', 'whatsapp'] &&
               data.status in ['queued', 'sent', 'failed'] &&
               data.createdAt == request.time;
      }

      allow create: if isSignedIn() && isValidNotification(incoming());
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Wishlist
    match /wishlist/{wishlistId} {
      function isValidWishlistItem(data) {
        return data.keys().hasAll(['userId', 'productId', 'addedAt']) &&
               data.userId == request.auth.uid &&
               data.productId is string &&
               data.addedAt == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidWishlistItem(incoming()) && isValidId(wishlistId);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Feedback
    match /feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['userId', 'userName', 'userEmail', 'type', 'rating', 'message', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.rating >= 1 && data.rating <= 5 &&
               data.message.size() <= 2000 &&
               data.createdAt == request.time;
      }
      allow create: if isSignedIn() && isEmailVerified() && isValidFeedback(incoming()) && isValidId(feedbackId);
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
