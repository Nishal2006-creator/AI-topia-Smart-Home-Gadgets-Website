{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A smart home gadget",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "room": { "type": "string" },
        "isNew": { "type": "boolean" },
        "rating": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "price", "category", "image", "description", "room"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "User": {
      "title": "User",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "themeMode": { "type": "string", "enum": ["dark", "light", "auto"] }
      }
    },
    "GlobalTheme": {
      "title": "Global Theme",
      "description": "Global visual settings controlled by admin",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "uiStyle": { "type": "string" },
        "fontSize": { "type": "number" },
        "animationsEnabled": { "type": "boolean" },
        "glowEnabled": { "type": "boolean" },
        "borderRadius": { "type": "number" },
        "containerPadding": { "type": "number" },
        "glassIntensity": { "type": "number" },
        "fontFamily": { "type": "string" },
        "backgroundStyle": { "type": "string", "enum": ["stars", "neural", "dust", "void", "nebula"] }
      }
    },
    "Automation": {
      "title": "Automation",
      "description": "A custom user automation workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "trigger": { 
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["time", "device", "voice"] },
            "value": { "type": "string" }
          }
        },
        "actions": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "deviceId": { "type": "string" },
              "command": { "type": "string" }
            }
          } 
        },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts (Email/WhatsApp)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["email", "whatsapp"] },
        "target": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "sent", "failed"] },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WishlistItem": {
      "title": "Wishlist Item",
      "description": "A saved product for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Feedback": {
      "title": "User Feedback",
      "description": "Feedback submitted by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string", "enum": ["suggestion", "bug", "complaint", "other"] },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "type", "rating", "message", "createdAt"]
    },
    "BotConfig": {
      "title": "Bot Config",
      "description": "Custom appearance settings for the Aumina Bot",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "eyeColor": { "type": "string" },
        "pattern": { "type": "string", "enum": ["none", "dots", "grid", "hex"] }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "The product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase history"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Pending and sent notifications"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/config/theme": {
      "schema": "GlobalTheme",
      "description": "Global branding settings"
    },
    "/config/bot": {
      "schema": "BotConfig",
      "description": "Bot aesthetic configuration"
    },
    "/automations/{automationId}": {
      "schema": "Automation",
      "description": "User defined automations"
    },
    "/wishlist/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "User saved products"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback submissions"
    }
  }
}
